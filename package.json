{
  "name": "solar-calculator",
  "version": "1.0.0",
  "description": "Hourly solar PV production estimator (Vue + Express) cross-checked against NREL PVWatts and PVGIS",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env index.js",
    "test": "node --test \"test/*.test.js\"",
    "validate": "node --env-file-if-exists=.env scripts/validate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^4.22.3"
  },
  "keywords": [],
  "author": "Shirak Avakian",
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.5",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4"
  }
}
